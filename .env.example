# Copy to .env and adjust. Never commit .env.
DB_NAME=finmind
DB_USER=finmind
DB_PASSWORD=finmind_dev_password
DB_URL=jdbc:postgresql://localhost:5432/finmind

# Must be at least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRY_MINUTES=60

